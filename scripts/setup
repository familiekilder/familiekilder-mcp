#!/bin/sh
# Install the local package and start `familiekilder-mcp setup` (forwarding flags
# such as --local, --no-open or --port). By default `setup` uses the fixed local
# port and opens the public setup page in the browser.
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
"$project_root/scripts/bootstrap-local-venv"
exec "$project_root/.private/venv/bin/familiekilder-mcp" setup "$@"
